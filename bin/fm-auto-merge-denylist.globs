# Central auto-merge deny list (one glob per line, matched case-insensitively
# against the whole changed path). bin/fm_auto_merge_check.py is its single
# consumer: a change touching any matching path is never eligible for automatic
# merge. This file owns the path names only; bin/fm_auto_merge_check.py also
# refuses sensitive changed content. It preserves every
# sensitive category the earlier docs-only allowlist refused, and it denies this
# auto-merge framework's own files so a pull request cannot widen its own
# eligibility. Changing it is therefore a sensitive change by construction.
# Matching is fnmatch on lowercased path and pattern, so "*" also spans "/".

# Agent instructions and skills
AGENTS.md
**/AGENTS.md
CLAUDE.md
**/CLAUDE.md
GROK_BOT.md
**/GROK_BOT.md
.agents/skills/**
**/.claude/skills/**
skills/**
**/skills/**

# No-mistakes, review and task configuration
.no-mistakes.yaml
**/.no-mistakes.yaml
.greptile/**
**/.greptile/**
.tasks.toml
**/.tasks.toml
.gitattributes
**/.gitattributes

# CI workflows, agent hooks and harness configuration
.github/**
**/hooks/**
**/hooks.json
.claude/**
.codex/**
.cursor/**
.grok/**
.omp/**
.opencode/**
.pi/**

# Every supervision, merge, launch, cleanup, send, lock, wake, watch, size-gate
# and auto-merge script under bin/ is sensitive. A small fix to a bin/ script
# stays with the human or the parent on the normal merge path.
bin/**

# Supervision and destructive-command names denied wherever they appear
**/*worker-guard*
**/*antidrift*
**/*wip*
**/*spawn*
**/*teardown*

# This auto-merge framework's own tests
tests/fm-auto-merge*

# Configuration, credentials and security-sensitive or destructive names
config/**
**/config/**
**/*config*
**/secrets/**
secrets/**
**/*secret*
**/*credential*
**/*password*
**/*token*
**/.env
**/.env.*
**/.netrc
**/.npmrc
**/.git-credentials
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.p8
**/*.jks
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/identifiants/**
identifiants/**
**/droits/**
droits/**
**/*droits*
**/*suppression*
**/*permission*
**/*rights*
**/*chmod*
**/*chown*
**/*remov*
**/*delet*
**/*supprim*
**/*force*
**/*github*
**/*gitlab*
**/*remote*
**/*publish*
**/*publication*
