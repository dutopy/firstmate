# Central auto-merge deny list (one glob per line, matched case-insensitively
# against the whole changed path). bin/fm_auto_merge_check.py is its single
# consumer: a change touching any matching path is never eligible for automatic
# merge. This is a name list, not a content scanner. It preserves every
# sensitive category the earlier docs-only allowlist refused, and it denies this
# auto-merge framework's own files so a pull request cannot widen its own
# eligibility. Changing it is therefore a sensitive change by construction.
# Matching is fnmatch on lowercased path and pattern, so "*" also spans "/".

# Agent instructions and skills
AGENTS.md
**/AGENTS.md
.agents/skills/**
**/.claude/skills/**

# CI workflows, agent hooks and harness configuration
.github/**
**/hooks/**
**/hooks.json
.claude/**
.codex/**
.cursor/**
.grok/**
.omp/**
.opencode/**
.pi/**
bin/fm-*-pretool-check.sh
bin/fm-*-command-policy.mjs
bin/fm-hook-host-lib.sh
bin/fm-kimi-turnend-hook.sh

# Merge authority and the supervision lifecycle
bin/fm-pr-merge.sh
bin/fm-merge-local.sh
bin/fm-merge-authority-lib.sh
bin/fm-merge-outcome-lib.sh
bin/fm-afk-contract.sh
bin/fm-lease-lib.sh
bin/fm-teardown.sh
bin/fm-spawn.sh
bin/fm-lock*
bin/fm-wake*
bin/fm-watch*
bin/fm-worker-guard*
bin/fm-antidrift*
bin/fm-wip*
bin/size-gate*
**/*worker-guard*
**/*antidrift*
**/*wip*
**/*spawn*
**/*teardown*

# This auto-merge framework
bin/fm-auto-merge*
bin/fm_auto_merge*
tests/fm-auto-merge*

# Install, update and bootstrap scripts
bin/fm-install-*
bin/fm-update*
bin/fm-bootstrap*

# Configuration, credentials and security-sensitive or destructive names
config/**
**/config/**
**/*config*
**/secrets/**
secrets/**
**/*secret*
**/*credential*
**/*password*
**/*token*
**/.env
**/.env.*
**/.netrc
**/.npmrc
**/.git-credentials
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.p8
**/*.jks
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/identifiants/**
identifiants/**
**/droits/**
droits/**
**/*droits*
**/*suppression*
**/*permission*
**/*rights*
**/*chmod*
**/*chown*
**/*remov*
**/*delet*
**/*supprim*
**/*force*
**/*github*
**/*gitlab*
